#!/bin/sh
#
# Fensterbilanz - Waechter der Befehlsbruecke, minuetlich.
#
# Gruppe 3 / MQTT (0.12.19, Entwurf fb E4; Bauvorschrift Gruppe 1, Nachtrag 19.10.2026): die Linie hat nur den
# Fuenf-Minuten-Takt (cron.05min -> fb_lauf.php); eine stehende Bruecke stuende damit bis zu fuenf Minuten. Der
# Waechter der gemeinsamen Stammfassung startet die Bruecke nur mit dem Haken "Befehle ueber MQTT annehmen" (ab Werk
# aus), haelt sie sonst an und sendet <praefix>/status/befehle (nie retained). Aufruf ueber bash (das Skript ist
# bash, nicht sh); stdout weg, die Fehlerausgabe nach cron.err wie in cron.05min.
#
# Die Platzhalter fuer bin- und Log-Ordner setzt der Installer ein; sie stehen deshalb NUR in den Befehlszeilen und
# nicht in diesem Kommentar (Begruendung in cron.05min).
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
touch "REPLACELBPLOGDIR/cron.err" 2>/dev/null
bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"REPLACELBPLOGDIR/cron.err"
