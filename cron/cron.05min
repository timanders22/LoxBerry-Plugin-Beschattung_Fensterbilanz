#!/bin/sh
#
# Fensterbilanz - der Lauf alle fuenf Minuten.
#
# Warum fuenf und nicht eine Minute: der Sonnenstand aendert sich um rund
# ein Viertelgrad in der Minute, das Urteil je Fenster also kaum. Der Weg
# ueber den Endpunkt ist ohnehin schneller - sobald Loxone einen neuen
# Messwert abliefert, wird gerechnet. Dieser Lauf ist der Rueckhalt fuer den
# Fall, dass gar keine Messwerte hereinkommen: dann muss trotzdem jemand
# merken, dass die Sonne weitergewandert ist, und die Zahl HERZ hochzaehlen.
#
# Der Platzhalter in der Zeile LAUF= wird bei der Installation durch den
# bin-Ordner des Plugins ersetzt. Er steht deshalb NUR dort und wird hier im
# Kommentar bewusst nicht wiederholt: der Installer ersetzt ihn ueberall,
# und danach stuende in diesem Kommentar ein fest verdrahteter Systempfad -
# genau danach sucht der Pluginpruefer, ohne den Zusammenhang zu lesen.
# (Ein Beispiel, das den beschriebenen Fehler selbst begeht, ist keines -
# in der ersten Fassung dieser Datei stand er hier noch.)
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

LAUF="REPLACELBPBINDIR/fb_lauf.php"

# DIE FEHLERAUSGABE GEHT NACH cron.err (I8, Durchgang 30.09.2026;
# Hausstandard Regeln/06, Bauform Docker NG 1.3.7 und Abfahrts-Assistent
# 1.6.10). LoxBerry ruft jede Cron-Datei mit "> /dev/null 2>&1" auf
# (/etc/cron.d/lbdefaults, Geraet/2026-09-05/11_cron.txt). Bis 0.12.10 stand
# hier "nur die Fehlerausgabe geht weiter" - sie ging nirgends hin, auch nicht
# "kein Standort", "es fehlen gueltige Messwerte" oder ein PHP-Abbruch
# (Installer-Pruefer I8). Das Verzeichnis wird vorher angelegt, sonst
# scheitert schon die Umlenkung; touch, weil ein Anhaengen ohne Inhalt die
# Aenderungszeit nicht auffrischt (Regeln/06, 16.09.2026); gekappt auf die
# letzten 300 Zeilen ueber 256 kB, denn log/ liegt im Arbeitsspeicher. Der
# Reiter Logdateien zeigt die Datei, sobald etwas darin steht.
ERR="REPLACELBPLOGDIR/cron.err"
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
touch "$ERR" 2>/dev/null
# 0.12.22 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.12.21 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
if [ -f "$ERR" ] && [ "$(stat -c %s "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
    tail -n 300 "$ERR" > "$ERR.neu" 2>/dev/null && mv -f "$ERR.neu" "$ERR"
fi

# Fail loud statt still. Ein Cron, der schweigend nichts tut, ist schlimmer
# als keiner: in Loxone sieht ein stehengebliebenes Urteil aus wie ein
# gueltiges. Die normale Ausgabe geht nicht mit - sonst stuende jeder Lauf
# in der Datei.
if [ ! -f "$LAUF" ]; then
    MELDUNG="Fensterbilanz: fb_lauf.php wurde nicht gefunden - es wird nicht gerechnet."
    command -v logger >/dev/null 2>&1 && logger -t fensterbilanz "$MELDUNG"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $MELDUNG" >> "$ERR" 2>/dev/null
    echo "$MELDUNG" >&2
    exit 1
fi

php "$LAUF" >/dev/null 2>>"$ERR"
